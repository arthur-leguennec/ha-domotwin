{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arthur-leguennec/ha-domotwin/blob/main/schema/plan.schema.json",
  "title": "DomoTwin plan",
  "description": "One storey of a home, `*.domotwin.json` (docs/plan-format.md). Lengths are centimetres; plan x grows to the right and plan y down the page; angles are degrees, clockwise on the plan. This schema describes the fields DomoTwin reads, and refuses others to catch a misspelt one; DomoTwin itself keeps fields it does not know as they are, without reading them. It reads more leniently than the schema (an optional value that is missing or out of range takes its default) and checks what a schema cannot: ids are unique (in the whole home), a `room` names a room of the plan, an outline does not cross itself and encloses at least 25 cm², `sides` has at most one entry per side, a piece's `model` is one of `models`, and a plan has at most 500 elements.",
  "type": "object",
  "required": [
    "format",
    "version"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "rooms"
      ],
      "properties": {
        "rooms": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "partitions"
      ],
      "properties": {
        "partitions": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "doors"
      ],
      "properties": {
        "doors": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "windows"
      ],
      "properties": {
        "windows": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "minItems": 1
        }
      }
    }
  ],
  "properties": {
    "format": {
      "const": "domotwin-plan"
    },
    "version": {
      "description": "The version of the format; a higher one is refused.",
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/name",
      "description": "The home's or the storey's name."
    },
    "wallThickness": {
      "description": "Default thickness of the walls.",
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "interior": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 10,
          "description": "A wall between two rooms."
        },
        "exterior": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "A façade, built outward."
        }
      }
    },
    "rooms": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "partitions": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/partition"
      }
    },
    "doors": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/door"
      }
    },
    "windows": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/window"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "views": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "models": {
      "description": "The 3D files pieces are drawn from, by id.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "coordinate": {
      "type": "number",
      "minimum": -50000,
      "maximum": 50000
    },
    "point": {
      "description": "[x, y] on the plan (cm).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/coordinate"
      }
    },
    "point3": {
      "description": "[x, y, height] (cm).",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "room": {
      "description": "A room; the walls follow from the rooms.",
      "type": "object",
      "required": [
        "id",
        "outline"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "outline": {
          "description": "Its corners in order: a simple polygon.",
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "color": {
          "$ref": "#/$defs/color",
          "description": "Its fill on the 2D plan."
        },
        "floor": {
          "description": "The floor.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "material": {
              "enum": [
                "plain",
                "grey-wood",
                "oak",
                "painted-wood",
                "beige-tiles",
                "white-tiles"
              ],
              "default": "plain"
            },
            "angle": {
              "type": "number",
              "description": "The direction of boards or tiles.",
              "default": 0
            }
          }
        },
        "walls": {
          "description": "The inner faces of its walls.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "finish": {
              "enum": [
                "plain",
                "wainscot",
                "chair-rail"
              ],
              "default": "plain"
            },
            "paint": {
              "$ref": "#/$defs/color",
              "description": "The colour of the inner faces."
            },
            "moulding": {
              "type": "boolean",
              "default": false,
              "description": "A crown moulding under the ceiling."
            }
          }
        },
        "sides": {
          "description": "One entry per side, side i running from corner i to the next.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "What differs on that side.",
                "type": "object",
                "required": [],
                "additionalProperties": false,
                "properties": {
                  "open": {
                    "type": "boolean",
                    "description": "No wall on that side."
                  },
                  "thickness": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "finish": {
                    "description": "Tiles or a paint colour on that side's inner face.",
                    "anyOf": [
                      {
                        "const": "tiles"
                      },
                      {
                        "$ref": "#/$defs/color"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "partition": {
      "description": "A free-standing wall, at least 5 cm long.",
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        },
        "thickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "room": {
          "$ref": "#/$defs/id",
          "description": "The room it belongs to."
        }
      }
    },
    "door": {
      "description": "A door: its ends 20–300 cm apart.",
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/point",
          "description": "One end along the wall (the leaf hangs here)."
        },
        "to": {
          "$ref": "#/$defs/point",
          "description": "The other end."
        },
        "opensTo": {
          "description": "The side the leaf swings to, walking from `from` to `to`.",
          "enum": [
            "left",
            "right"
          ],
          "default": "right"
        },
        "room": {
          "$ref": "#/$defs/id",
          "description": "The room it belongs to."
        },
        "style": {
          "enum": [
            "hinged",
            "glazed",
            "double",
            "folding",
            "double-folding",
            "sliding",
            "barn",
            "opening",
            "sealed"
          ],
          "default": "hinged"
        },
        "open": {
          "$ref": "#/$defs/fraction",
          "description": "How open the leaf is drawn (0 closed).",
          "default": 1
        }
      }
    },
    "window": {
      "description": "A window: its ends 20–1000 cm apart.",
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/point",
          "description": "One end along the wall."
        },
        "to": {
          "$ref": "#/$defs/point",
          "description": "The other end."
        },
        "opensTo": {
          "description": "The side the leaf swings to, walking from `from` to `to`.",
          "enum": [
            "left",
            "right"
          ],
          "default": "right"
        },
        "room": {
          "$ref": "#/$defs/id",
          "description": "The room it belongs to."
        }
      }
    },
    "item": {
      "description": "A piece of furniture, an appliance, a lamp, stairs.",
      "type": "object",
      "required": [
        "id",
        "at",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "box",
            "sofa",
            "armchair",
            "coffee-table",
            "tv",
            "plant",
            "bed",
            "nightstand",
            "dresser",
            "desk",
            "chair",
            "bookcase",
            "counter",
            "sink",
            "stove",
            "fridge",
            "dining-table",
            "bathtub",
            "vanity",
            "tall-cabinet",
            "toilet",
            "washer",
            "dryer",
            "bin",
            "wall-cabinet",
            "shelf",
            "trolley",
            "dishwasher",
            "hood",
            "bulkhead",
            "backsplash",
            "shoe-cabinet",
            "radiator",
            "curtain",
            "picture",
            "picture-wall",
            "mirror",
            "chandelier",
            "pendant",
            "spotlight",
            "floor-lamp",
            "ceiling-light",
            "ceiling-fan",
            "table-lamp",
            "lantern",
            "desk-lamp",
            "glazed-bookcase",
            "open-shelving",
            "chest",
            "side-table",
            "office-chair",
            "round-table",
            "console",
            "printer",
            "3d-printer",
            "stairs"
          ],
          "default": "box",
          "description": "How it is drawn and what it does (docs/plan-format.md)."
        },
        "at": {
          "$ref": "#/$defs/point",
          "description": "The centre of its footprint."
        },
        "size": {
          "description": "[width, depth, height] (cm); its front faces +y before turning.",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          ]
        },
        "rotation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360,
          "default": 0,
          "description": "Clockwise, about its centre."
        },
        "lift": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "default": 0,
          "description": "The height of its underside."
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "A variant of its kind."
        },
        "room": {
          "$ref": "#/$defs/id",
          "description": "The room it belongs to."
        },
        "fixed": {
          "type": "boolean",
          "default": false,
          "description": "Built in: edit mode does not move it."
        },
        "light": {
          "description": "Lamps only.",
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "on": {
              "type": "boolean",
              "default": true
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "kelvin": {
              "type": "number",
              "minimum": 1800,
              "maximum": 6500
            },
            "power": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 2,
              "description": "A fraction of the kind's usual light."
            }
          }
        },
        "open": {
          "$ref": "#/$defs/fraction",
          "default": 1,
          "description": "Curtains only: how open they are drawn."
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "description": "A model of `models` the piece is drawn from."
        }
      }
    },
    "view": {
      "description": "A saved viewpoint.",
      "type": "object",
      "required": [
        "id",
        "eye",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 60
        },
        "eye": {
          "$ref": "#/$defs/point3"
        },
        "target": {
          "$ref": "#/$defs/point3"
        }
      }
    },
    "model": {
      "description": "A 3D model.",
      "type": "object",
      "required": [
        "size",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "size": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 10000
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          ]
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "file": {
          "description": "The file, stored by the integration under its hash.",
          "type": "object",
          "required": [
            "format",
            "hash",
            "bytes",
            "up"
          ],
          "additionalProperties": false,
          "properties": {
            "format": {
              "enum": [
                "glb",
                "gltf",
                "obj",
                "stl",
                "3mf"
              ]
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the file."
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8000000
            },
            "up": {
              "enum": [
                "y",
                "z"
              ]
            },
            "data": {
              "type": "string",
              "pattern": "^data:[^,;]*;base64,",
              "description": "The file itself, in an exported plan; a stored plan has its hash only."
            }
          }
        }
      }
    }
  }
}
